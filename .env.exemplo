# Configurações do Extrator Google Maps.
# Copie este arquivo para ".env" (na mesma pasta) e ajuste. Linhas com # são comentários.
# Variáveis definidas no sistema (ex.: PORTA=3300 npm start) têm prioridade sobre este arquivo.

# Porta da interface web (http://localhost:PORTA). Troque se a 3210 estiver ocupada.
PORTA=3210

# Intervalo mínimo, em milissegundos, entre duas requisições ao Google (somando todas as buscas
# em paralelo). Aumente (ex.: 1500) se aparecer "O Google limitou as requisições (429)".
INTERVALO_MS=600

# Abre a interface no navegador padrão ao iniciar (1 = sim; apague a linha para não abrir).
# ABRIR_NAVEGADOR=1
